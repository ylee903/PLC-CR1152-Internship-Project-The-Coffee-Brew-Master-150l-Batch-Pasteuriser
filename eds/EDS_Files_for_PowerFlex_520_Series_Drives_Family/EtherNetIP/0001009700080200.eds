[Connection Manager]
        Connection1 =                   $ Exclusive Owner
                0x04010002,             $ trigger & transport
                                        $   0-15   = supported transport classes (class 1)
                                        $   16     = trigger: cyclic (1=supported)
                                        $   17     = trigger: change of state (0=not supported)
                                        $   18     = trigger: application (0=not supported)
                                        $   19-23  = trigger: reserved (must be zero)
                                        $   24     = application type: listen-only (0=not supported)
                                        $   25     = application type: input-only (0=not supported)
                                        $   26     = application type: exclusive-owner (1=supported)
                                        $   27     = application type: redundant-owner (0=not supported)
                                        $   28-30  = reserved (must be zero)
                                        $   31     = Direction: Client=0, Server=1 (don't care for classes 0 and 1)
                0x44640405,             $ point/multicast & priority & realtime format
                                        $   0      = O->T fixed size (1=supported)
                                        $   1      = O->T variable size (0=not supported)
                                        $   2      = T->O fixed size (1=supported)
                                        $   3      = T->O variable size (0=not supported)
                                        $   4-5    = O->T number of bytes per slot (obsolete)
                                        $   6-7    = T->O number of bytes per slot (obsolete)
                                        $   8-10   = O->T Real time transfer format (4 byte run/idle)
                                        $   11     = reserved (must be zero)
                                        $   12-14  = T->O Real time transfer format (4 byte run/idle)
                                        $   15     = reserved (must be zero)
                                        $   16     = O->T connection type: Null (0=not supported)
                                        $   17     = O->T connection type: Multicast (0=not supported)
                                        $   18     = O->T connection type: Point-to-point (1=supported)
                                        $   19     = O->T connection type: reserved
                                        $   20     = T->O connection type: Null (0=not supported)
                                        $   21     = T->O connection type: Multicast (1=supported)
                                        $   22     = T->O connection type: Point-to-point (1=supported)
                                        $   23     = T->O connection type: reserved
                                        $   24     = O->T priority: Low (0=not supported)
                                        $   25     = O->T priority: High (0=not supported)
                                        $   26     = O->T priority: Scheduled (1=supported)
                                        $   27     = O->T priority: reserved
                                        $   28     = T->O priority: Low (0=not supported)
                                        $   29     = T->O priority: High (0=not supported)
                                        $   30     = T->O priority: Scheduled (1=supported)
                                        $   31     = T->O priority: reserved
                ,Param2,Assem2,         $ O->T RPI, size, format
                ,Param1,Assem1,         $ T->O RPI, size, format
                ,,                      $ proxy config size, format
                ,,                      $ target config size, format
                "Discrete Exclusive Owner",    $ connection name
                "",                     $ help string
                "20 04 24 06 2C 02 2C 01";    $ path

