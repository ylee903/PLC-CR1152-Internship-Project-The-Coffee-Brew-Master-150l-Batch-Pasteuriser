$ DeviceNet EDS File
$ This is an ODVA conformant file for this device with support for
$ Rockwell Automation DeviceNet Premier Integration

[File]
        DescText = "This is an EDS file for a PowerFlex 52x via a 25-COMM-D card in multi-drive mode";
        CreateDate = 08-19-2019;
        CreateTime = 09:32:01;
        ModDate = 08-19-2019;
        ModTime = 09:32:01;
        Revision = 1.1;
        HomeURL = "http://www.ab.com/networks/eds/DN/00010095031E0100.eds";

[Device]
        VendCode = 1;
        VendName = "Rockwell Automation - Allen-Bradley";
        ProdType = 0x95;
        ProdTypeStr = "HS-DSI to DeviceNet";
        ProdCode = 0x31e;
        MajRev = 0x1;
        MinRev = 0x1;
        ProdName = "25-COMM-D Multi-Drive";
        Catalog = "25-COMM-D";
        Icon = "PF52X.ico";
        1_EDS_AOP_Support = "No";
        

[Device Classification]

	Class1 = DeviceNet;


[IO_Info]

	1_COSetPathNotSupported = 1;		$ Supports Direct Path Setting = No
	1_COSetSizeNotSupported = 1;		$ Supports Direct Size Setting = No

	Default       = 0x0001;                 $ Default I/O = Polled

	PollInfo      = 0x000D,                 $ Compatible with an I/O mix of Cyclic, COS, and Polled
	                1,                      $ Default Input = Input1
	                1;                      $ Default Output = Output1

	COSInfo       = 0x0005,                 $ Compatible with an I/O mix of Cos and Polled
	                1,                      $ Default Input = Input1
	                1;                      $ Default Output = Output1

	CyclicInfo    = 0x0009,                 $ Compatible with an I/O mix of Cyclic and Polled
	                1,                      $ Default Input = Input1
	                1;                      $ Default Output = Output1

	PollInfoExa   = 0x000D,                 $ Compatible with an I/O mix of Cyclic, COS, and Polled
	                1,                      $ Default Input = Input2
	                1;                      $ Default Output = Output2

	COSInfoExa    = 0x0005,                 $ Compatible with an I/O mix of COS and Polled
	                1,                      $ Default Input = Input1
	                1;                      $ Default Output = Output1

	CyclicInfoExa = 0x0009,                 $ Compatible with an I/O mix of Cyclic and Polled
	                1,                      $ Default Input = Input1
	                1;                      $ Default Output = Output1

